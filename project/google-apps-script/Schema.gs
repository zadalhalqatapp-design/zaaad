/** يرجع اسم العمود العربي للمفتاح البرمجي داخل ورقة معينة */
function colName(sheetArabicName, codeKey) {
  var map = COL_MAP[sheetArabicName];
  if (!map) return codeKey;
  return map[codeKey] || codeKey;
}

/** يحوّل كائن بمفاتيح برمجية إلى كائن بمفاتيح عربية لورقة معينة */
function toArabicRow(sheetArabicName, data) {
  var map = COL_MAP[sheetArabicName];
  if (!map) return data;
  var result = {};
  for (var key in data) {
    var arabicKey = map[key] || key;
    result[arabicKey] = data[key];
  }
  return result;
}

/** يحوّل صف بأعمدة عربية إلى كائن بمفاتيح برمجية */
function fromArabicRow(sheetArabicName, row) {
  var map = COL_MAP[sheetArabicName];
  if (!map) return row;
  var reverse = {};
  for (var code in map) reverse[map[code]] = code;
  var result = {};
  for (var arabicKey in row) {
    var codeKey = reverse[arabicKey] || arabicKey;
    result[codeKey] = row[arabicKey];
  }
  return result;
}
